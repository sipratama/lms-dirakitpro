# Copy file ini jadi .env lalu isi nilainya. Jangan pernah commit .env.
#
# === App ===
# Base URL aplikasi ini sendiri, dipakai server-side untuk membangun callback URL (mis. Midtrans finish redirect).
APP_URL=http://localhost:3000

# === Database (dipakai docker-compose.yml + Drizzle ORM di langkah 8) ===
POSTGRES_USER=dirakitpro
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dirakitpro
POSTGRES_PORT=5432
# Untuk koneksi dari host (pnpm dev / Drizzle CLI) ke Postgres yang dijalankan
# lewat docker-compose. Host & port harus konsisten dengan tiga variabel di atas.
DATABASE_URL=postgresql://dirakitpro:change-me@localhost:5432/dirakitpro

# === Auth — Clerk ===
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Signing secret webhook /api/webhooks/clerk (Clerk Dashboard > Webhooks > pilih endpoint > Signing Secret)
CLERK_WEBHOOK_SIGNING_SECRET=

# === Payment — Midtrans (langkah 10) ===
MIDTRANS_SERVER_KEY=
# Client key HARUS diekspos ke browser (dipakai snap.js untuk buka overlay Snap) — karenanya prefix NEXT_PUBLIC_.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# === Storage — Cloudflare R2 (belum dipakai kode, disambungkan di langkah 11) ===
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# === Email — Resend (belum dipakai kode, disambungkan di langkah 11) ===
RESEND_API_KEY=

# === Analytics — PostHog (belum dipakai kode, disambungkan di langkah 11) ===
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# === Monitoring — Sentry (belum dipakai kode, disambungkan di langkah 11) ===
SENTRY_DSN=

# === E2E (Playwright) — opsional, lihat apps/web/e2e/README.md ===
# User khusus E2E di Clerk *development instance* (bukan production). Kalau dua
# variabel ini kosong, spec yang butuh login otomatis di-SKIP, bukan gagal.
# Buat user-nya lewat: node apps/web/e2e/scripts/clerk-test-user.ts create
E2E_CLERK_USER_EMAIL=
E2E_CLERK_USER_PASSWORD=
# Server key palsu untuk menandatangani payload webhook Midtrans di E2E. Nilainya
# di-inject ke dev server oleh playwright.config.ts, jadi TIDAK perlu kredensial
# Midtrans sandbox asli. Biarkan kosong untuk memakai default.
E2E_MIDTRANS_SERVER_KEY=
# Override base URL kalau dev server tidak di port 3000.
E2E_BASE_URL=
